#!/usr/bin/env bash
# Pre-push: run lint and type checks locally before a push reaches CI.
#
#   ruff check + ruff format --check   WHOLE tree (apps/api, apps/worker, lib) when a
#                                      .py file there or the ruff config changed
#   eslint (whole apps/web project)    when anything under apps/web or packages/ changed
#   tsc --noEmit (whole web project)   when anything under apps/web or packages/ was
#                                      added, modified, renamed OR deleted
#   bin/migrations check               when apps/api/alembic changed (warning only)
#
# Lint covers the whole tree, not just the changed files (CITY-651: main is
# lint-clean, and CI's Lint workflow checks the same scope). The changed files
# only decide WHICH checks run, so a docs-only push skips them. ruff is pinned
# (pyproject.toml dev extra, lint.yml); a different local ruff gets a warning.
#
# What gets checked is the PUSHED tree of each ref, not the working tree: each
# ref's commit is exported with `git archive` into a temp dir and linted there.
# So `git push origin CITY-NNN` from another checkout, or uncommitted edits in
# this one, can't produce a false pass or a false block. node_modules is
# symlinked in from this checkout for eslint/tsc. A ref whose tree (and base)
# matches one already checked in this push is skipped.
#
# All blocking checks run, then failures are reported together. A missing tool
# is a FAILURE, not a skip: a lint gate that silently switches itself off is
# worse than a blocked push. Bypass only if you've checked another way:
#   git push --no-verify
#
# Setup (once per clone): git config --local core.hooksPath .githooks

HOOK="[pre-push]"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
BASE_REF="origin/main"

# ── Failure tracking ──────────────────────────────────────────────────────────
FAILURES=()
add_failure() {
  local f
  for f in "${FAILURES[@]}"; do [[ "$f" == "$1" ]] && return 0; done
  FAILURES+=("$1")
}
run_check() {
  local name="$1"; shift
  if ! "$@"; then
    add_failure "$name"
  fi
}

# ── Temp trees (removed on exit) ──────────────────────────────────────────────
TMP_TREES=()
cleanup_trees() {
  local t link
  for t in "${TMP_TREES[@]}"; do
    # Unlink the node_modules symlinks first so nothing can recurse into them.
    for link in "$t/node_modules" "$t/apps/web/node_modules"; do
      [[ -L "$link" ]] && rm -f "$link"
    done
    rm -rf "$t"
  done
}
trap cleanup_trees EXIT

# Scratch dir for diff listings: they are written to files (not read through
# process substitution) so a failing `git diff` is caught, not read as "no
# changes".
LIST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/city-prepush.XXXXXX") || {
  echo "$HOOK ERROR: could not create a temp dir." >&2; exit 1; }
TMP_TREES+=("$LIST_DIR")

# ── Tools (resolved once) ─────────────────────────────────────────────────────
if [[ -x "$REPO_ROOT/.venv/bin/ruff" ]]; then
  RUFF=("$REPO_ROOT/.venv/bin/ruff")
elif command -v ruff &>/dev/null; then
  RUFF=(ruff)
elif command -v uvx &>/dev/null; then
  RUFF=(uvx ruff)
else
  RUFF=()
fi

# npm workspaces hoist binaries to the root node_modules.
web_bin() {
  local name="$1" dir
  for dir in "$REPO_ROOT/apps/web/node_modules/.bin" "$REPO_ROOT/node_modules/.bin"; do
    [[ -x "$dir/$name" ]] && { echo "$dir/$name"; return 0; }
  done
  return 1
}

# ── Per-ref check ─────────────────────────────────────────────────────────────
# Usage: check_ref <local ref> <local sha>
check_ref() {
  local ref="$1" sha="$2" base path tree link key dir
  local py_changed="" web_changed="" alembic_changed=""
  local ruff_dirs=()
  local all_list="$LIST_DIR/all"

  base=$(git merge-base "$BASE_REF" "$sha" 2>/dev/null || true)
  if [[ -z "$base" ]]; then
    echo "$HOOK WARNING: no merge-base with $BASE_REF for $ref (run 'git fetch origin'); checking files in the tip commit only."
    base=$(git rev-parse -q --verify "$sha^" 2>/dev/null || echo "$EMPTY_TREE")
  fi

  # The same tree against the same base was already checked (e.g. one commit
  # pushed to several refs): checking it again only costs time.
  key="$(git rev-parse "$sha^{tree}" 2>/dev/null):$base"
  if [[ " $CHECKED_KEYS " == *" $key "* ]]; then
    echo "$HOOK $ref: same tree as a ref already checked, skipping."
    return 0
  fi
  CHECKED_KEYS+=" $key"

  if ! git diff --name-only -z --no-renames "$base" "$sha" > "$all_list"; then
    add_failure "could not list the files changed on $ref (git diff failed)"
    return 0
  fi

  # Triggers: any change INCLUDING deletions (--no-renames splits a rename into
  # delete + add), so deleting an imported module still runs tsc. NUL-separated
  # (-z) so non-ASCII / odd paths aren't C-quoted and dropped. What runs then
  # checks the whole pushed tree, not just these paths.
  while IFS= read -r -d '' path; do
    case "$path" in
      apps/api/*.py | apps/worker/*.py | lib/*.py | pyproject.toml | ruff.toml | .ruff.toml)
        py_changed=1 ;;
    esac
    case "$path" in
      apps/web/* | packages/*) web_changed=1 ;;
    esac
    case "$path" in
      apps/api/alembic/*) alembic_changed=1 ;;
    esac
  done < "$all_list"

  if [[ -z "$py_changed" && -z "$web_changed" && -z "$alembic_changed" ]]; then
    return 0
  fi

  # Materialize the pushed tree.
  tree=$(mktemp -d "${TMPDIR:-/tmp}/city-prepush.XXXXXX") || {
    add_failure "could not create a temp dir to check $ref"; return 0; }
  TMP_TREES+=("$tree")
  # pipefail (scoped to this subshell) so a failed `git archive` isn't masked
  # by tar exiting 0 on a truncated stream.
  if ! (set -o pipefail; git archive --format=tar "$sha" | tar -xf - -C "$tree"); then
    add_failure "could not export $ref ($sha) for checking"
    return 0
  fi
  for link in node_modules apps/web/node_modules; do
    if [[ -d "$REPO_ROOT/$link" && -d "$(dirname "$tree/$link")" ]]; then
      ln -s "$REPO_ROOT/$link" "$tree/$link"
    fi
  done

  local suffix=""
  [[ "$MULTI_REF" == 1 ]] && suffix=" [$ref]"
  echo "$HOOK checking $ref ($(git rev-parse --short "$sha"))..."

  # 1. ruff (whole tree)
  for dir in apps/api apps/worker lib; do
    [[ -d "$tree/$dir" ]] && ruff_dirs+=("$dir")
  done
  if [[ -n "$py_changed" && ${#ruff_dirs[@]} -gt 0 ]]; then
    if [[ ${#RUFF[@]} -eq 0 ]] || ! "${RUFF[@]}" --version &>/dev/null; then
      add_failure "ruff is not installed (brew install ruff, or install uv)"
    else
      local want have
      want=$(grep -oE 'ruff==[0-9]+\.[0-9]+\.[0-9]+' "$tree/pyproject.toml" 2>/dev/null | head -1 | cut -d= -f3)
      have=$("${RUFF[@]}" --version 2>/dev/null | awk '{print $2}')
      if [[ -n "$want" && "$have" != "$want" ]]; then
        echo "$HOOK WARNING: ruff $have here, but CI pins $want; format results can differ (uvx ruff@$want, or pip install -e '.[dev]')."
      fi
      echo "$HOOK ruff (whole tree: ${ruff_dirs[*]})..."
      run_check "ruff check (fix: ruff check --fix ${ruff_dirs[*]})$suffix" \
        bash -c 'cd "$1" && shift && exec "$@"' _ "$tree" \
        "${RUFF[@]}" check --no-cache --output-format=concise "${ruff_dirs[@]}"
      run_check "ruff format (fix: ruff format ${ruff_dirs[*]})$suffix" \
        bash -c 'cd "$1" && shift && exec "$@"' _ "$tree" \
        "${RUFF[@]}" format --no-cache --check --diff --quiet "${ruff_dirs[@]}"
    fi
  fi

  # 2. eslint + tsc (apps/web)
  if [[ -n "$web_changed" ]]; then
    # eslint/tsc come from THIS checkout's node_modules; say so when the pushed
    # ref has different dependencies than what is installed here.
    if ! git diff --quiet HEAD "$sha" -- package-lock.json apps/web/package-lock.json 2>/dev/null; then
      echo "$HOOK WARNING: $ref changes package-lock.json relative to this checkout; eslint/tsc run with this checkout's node_modules (run 'npm ci' on that ref if results look wrong)."
    fi
    local eslint tsc
    eslint=$(web_bin eslint || true)
    tsc=$(web_bin tsc || true)

    if [[ -z "$eslint" ]]; then
      add_failure "eslint is not installed (run 'npm ci' at the repo root)"
    elif [[ ! -f "$tree/apps/web/eslint.config.js" ]]; then
      add_failure "eslint: $ref has no apps/web/eslint.config.js"
    else
      # Whole project, errors only: warnings don't block here or in CI's Lint
      # workflow, and printing ~90 of them on every push buries the errors.
      echo "$HOOK eslint (whole apps/web)..."
      run_check "eslint (apps/web)$suffix" bash -c 'cd "$1" && shift && exec "$@"' _ \
        "$tree/apps/web" "$eslint" --quiet .
    fi

    if [[ -z "$tsc" ]]; then
      add_failure "tsc is not installed (run 'npm ci' at the repo root)"
    elif [[ ! -f "$tree/apps/web/tsconfig.json" ]]; then
      add_failure "tsc: $ref has no apps/web/tsconfig.json"
    else
      echo "$HOOK tsc..."
      run_check "tsc --noEmit (apps/web)$suffix" bash -c 'cd "$1" && shift && exec "$@"' _ \
        "$tree" "$tsc" --noEmit -p apps/web/tsconfig.json
    fi
  fi

  # 3. Alembic chain (non-blocking). CI's "Assert single Alembic head" check is
  # the gate; this is an early warning.
  if [[ -n "$alembic_changed" && -x "$tree/bin/migrations" ]]; then
    echo "$HOOK alembic chain..."
    local status=0
    if [[ -z "${ALEMBIC_CMD:-}" && -x "$REPO_ROOT/.venv/bin/alembic" ]]; then
      ALEMBIC_CMD="$REPO_ROOT/.venv/bin/alembic" "$tree/bin/migrations" check || status=$?
    else
      "$tree/bin/migrations" check || status=$?
    fi
    if [[ "$status" -eq 1 ]]; then
      echo ""
      echo "$HOOK WARNING: Alembic chain problem above. CI will fail."
      echo "$HOOK    Multiple heads: update onto origin/main, then bin/migrations fix-heads"
      echo ""
    elif [[ "$status" -ne 0 ]]; then
      echo "$HOOK WARNING: could not check Alembic heads (exit $status); CI will still check."
    fi
  fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.
# Read them all first so no check can consume the hook's stdin.
REFS=()
SHAS=()
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "${local_sha:-}" || "$local_sha" == "$ZERO_SHA" ]] && continue  # branch delete
  REFS+=("$local_ref")
  SHAS+=("$local_sha")
done

if [[ ${#SHAS[@]} -eq 0 ]]; then
  echo "$HOOK No changed files to check."
  exit 0
fi

MULTI_REF=0
if [[ ${#SHAS[@]} -gt 1 ]]; then
  MULTI_REF=1
  echo "$HOOK checking ${#SHAS[@]} refs..."
fi
CHECKED_KEYS=""

for i in "${!SHAS[@]}"; do
  check_ref "${REFS[$i]}" "${SHAS[$i]}" </dev/null
done

# ── Summary ───────────────────────────────────────────────────────────────────
if [[ ${#FAILURES[@]} -gt 0 ]]; then
  echo ""
  echo "$HOOK Pre-push checks FAILED:"
  for f in "${FAILURES[@]}"; do
    echo "  ✗ $f"
  done
  echo ""
  echo "$HOOK Fix the above, then push again. To bypass: git push --no-verify"
  exit 1
fi

echo "$HOOK All pre-push checks passed."
