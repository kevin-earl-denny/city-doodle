#!/usr/bin/env bash
#
# migrations - Alembic migration-chain tooling for apps/api
#
# Catches the chain problems parallel PRs keep introducing (#376 "duplicate
# revision 021"): multiple heads and duplicate revision IDs.
#
#   bin/migrations check                 exit 0 ok / 1 chain bug (multiple heads, duplicate
#                                        revision, dangling down_revision) / 2 env broken
#   bin/migrations heads                 list current heads
#   bin/migrations fix-heads [--dry-run] [-m MSG]   generate an empty merge migration
#
# Alembic resolution (first match wins):
#   1. $ALEMBIC_CMD                      (one executable path; CI sets it to `alembic`)
#   2. .venv/bin/alembic                 (the README's dev venv, if present)
#   3. uv run --no-project --with ...    (ephemeral env; nothing to install)
#   4. alembic on PATH
#
# `alembic heads` imports every revision file but never runs env.py, so no
# database is needed. Revisions may import city_api (alembic.ini prepends src/
# to sys.path), which pulls in sqlalchemy.ext.asyncio, hence sqlalchemy[asyncio].

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
API_DIR="$REPO_ROOT/apps/api"
VERSIONS_DIR="$API_DIR/alembic/versions"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

# ALEMBIC is an array so a repo path containing spaces survives (CITY-666).
resolve_alembic() {
  if [[ -n "${ALEMBIC_CMD:-}" ]]; then
    ALEMBIC=("$ALEMBIC_CMD")
  elif [[ -x "$REPO_ROOT/.venv/bin/alembic" ]]; then
    ALEMBIC=("$REPO_ROOT/.venv/bin/alembic")
  elif command -v uv &>/dev/null; then
    ALEMBIC=(uv run --no-project --quiet --with alembic --with "sqlalchemy[asyncio]" --with python-dotenv alembic)
  elif command -v alembic &>/dev/null; then
    ALEMBIC=(alembic)
  else
    echo -e "${RED}Error: alembic not found. Install uv, or: pip install alembic 'sqlalchemy[asyncio]' python-dotenv${RESET}" >&2
    exit 2
  fi
}

run_alembic() {
  (cd "$API_DIR" && "${ALEMBIC[@]}" -c alembic.ini "$@")
}

# Prints newline-separated head revision IDs. Any alembic failure must FAIL LOUD
# (exit 2), never be swallowed into a clean-looking "0 heads". Runs inside a
# command substitution, so callers propagate with `|| exit $?`.
get_heads() {
  local out status=0
  out=$(run_alembic heads 2>&1) || status=$?
  if [[ "$status" -ne 0 ]]; then
    echo -e "${RED}Error: alembic could not list migration heads (exit $status).${RESET}" >&2
    echo "$out" >&2
    exit 2
  fi
  # Keep only "<rev> (head)" lines; drop warnings alembic prints alongside.
  printf '%s\n' "$out" | awk '/\(head\)/ {print $1}'
}

# Static scan of versions/*.py (stdlib AST, no imports, no database). Prints one
# problem per line:
#   dup <revision> <file>             revision ID defined in more than one file
#   dangling <file> <down_revision>   down_revision names a revision no file defines
# Alembic only warns on duplicates and silently keeps one of them, so the heads
# count alone can look healthy; and a dangling parent makes `alembic heads`
# crash, which would otherwise surface as exit 2 ("environment broken") even
# though it is a chain bug. Exits non-zero only if a file can't be parsed.
scan_chain() {
  python3 - "$VERSIONS_DIR" <<'PY'
import ast, collections, pathlib, sys

def const_strs(value):
    """String revision IDs in a str / tuple / list constant (None -> none)."""
    if isinstance(value, ast.Constant) and isinstance(value.value, str):
        return [value.value]
    if isinstance(value, (ast.Tuple, ast.List)):
        return [e.value for e in value.elts
                if isinstance(e, ast.Constant) and isinstance(e.value, str)]
    return []

defined = collections.defaultdict(list)
parents = []  # (file, down_revision)
for path in sorted(pathlib.Path(sys.argv[1]).glob("*.py")):
    for node in ast.parse(path.read_text(), filename=str(path)).body:
        target = value = None
        if isinstance(node, ast.Assign) and len(node.targets) == 1:
            target, value = node.targets[0], node.value
        elif isinstance(node, ast.AnnAssign):
            target, value = node.target, node.value
        if not isinstance(target, ast.Name) or value is None:
            continue
        if target.id == "revision":
            for rev in const_strs(value):
                defined[rev].append(path.name)
        elif target.id == "down_revision":
            parents.extend((path.name, rev) for rev in const_strs(value))
for rev, files in sorted(defined.items()):
    if len(files) > 1:
        for f in files:
            print("dup", rev, f)
for f, rev in parents:
    if rev not in defined:
        print("dangling", f, rev)
PY
}

count_lines() {
  if [[ -z "$1" ]]; then echo 0; else printf '%s\n' "$1" | grep -c .; fi
}

cmd_check() {
  local failed=0 problems dups dangling heads count
  problems=$(scan_chain) || {
    echo -e "${RED}Error: could not scan $VERSIONS_DIR for revision IDs.${RESET}" >&2
    exit 2
  }
  dups=$(printf '%s\n' "$problems" | awk '$1 == "dup" {print $2, $3}')
  dangling=$(printf '%s\n' "$problems" | awk '$1 == "dangling" {print $2 " -> down_revision " $3}')
  if [[ -n "$dups" ]]; then
    echo -e "${RED}${BOLD}Duplicate Alembic revision IDs:${RESET}"
    printf '%s\n' "$dups" | sed 's/^/  - /'
    echo "Give one of each pair a new revision ID and repoint its children's down_revision."
    failed=1
  fi
  if [[ -n "$dangling" ]]; then
    # A chain bug, not an environment fault: alembic can't even load this
    # chain, so report it here and stop before `alembic heads` crashes on it.
    echo -e "${RED}${BOLD}down_revision points at a revision that no migration defines:${RESET}"
    printf '%s\n' "$dangling" | sed 's/^/  - /'
    echo "Point it at an existing revision (bin/migrations heads lists the current head)."
    exit 1
  fi

  resolve_alembic
  heads=$(get_heads) || exit $?
  count=$(count_lines "$heads")
  if [[ "$count" -eq 0 ]]; then
    echo -e "${RED}Error: alembic reported no heads (misconfigured script_location?).${RESET}" >&2
    exit 2
  elif [[ "$count" -gt 1 ]]; then
    echo -e "${RED}${BOLD}Multiple Alembic heads detected ($count):${RESET}"
    printf '%s\n' "$heads" | sed 's/^/  - /'
    echo -e "Fix: update your branch onto origin/main, then ${BOLD}bin/migrations fix-heads${RESET}"
    failed=1
  fi

  if [[ "$failed" -eq 0 ]]; then
    echo -e "${GREEN}Single head ($heads), no duplicate revisions.${RESET}"
  fi
  exit "$failed"
}

cmd_heads() {
  resolve_alembic
  local heads
  heads=$(get_heads) || exit $?
  echo -e "${BOLD}Current heads ($(count_lines "$heads")):${RESET}"
  if [[ -z "$heads" ]]; then
    echo "  (none)"
  else
    printf '%s\n' "$heads" | sed 's/^/  - /'
  fi
}

cmd_fix_heads() {
  local dry_run=false message=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      -m)
        [[ -n "${2:-}" ]] || { echo -e "${RED}Error: -m requires a message.${RESET}" >&2; exit 1; }
        message="$2"; shift 2 ;;
      *)
        echo -e "${RED}Unknown option: $1${RESET} (see 'bin/migrations help')" >&2
        exit 1 ;;
    esac
  done

  resolve_alembic
  local heads count
  heads=$(get_heads) || exit $?
  count=$(count_lines "$heads")
  if [[ "$count" -eq 0 ]]; then
    echo -e "${RED}Error: alembic reported no heads.${RESET}" >&2
    exit 2
  elif [[ "$count" -eq 1 ]]; then
    echo -e "${GREEN}Single head, nothing to merge.${RESET}"
    exit 0
  fi

  message="${message:-merge_${count}_heads}"
  echo -e "${YELLOW}${BOLD}Merging $count heads:${RESET}"
  printf '%s\n' "$heads" | sed 's/^/  - /'

  if [[ "$dry_run" == "true" ]]; then
    echo -e "${BOLD}[dry-run]${RESET} would run (in apps/api): alembic merge heads -m \"$message\""
    exit 0
  fi

  run_alembic merge heads -m "$message"
  echo -e "${GREEN}${BOLD}Merge migration created in apps/api/alembic/versions/.${RESET}"
  echo "Rename it to the next NNN_ prefix to match the repo convention, then commit it."

  heads=$(get_heads) || exit $?
  if [[ "$(count_lines "$heads")" -le 1 ]]; then
    echo -e "${GREEN}Verified: single head after merge.${RESET}"
  else
    echo -e "${YELLOW}Warning: still $(count_lines "$heads") heads after merge.${RESET}"
  fi
}

cmd_help() {
  cat <<'EOF'
Usage: bin/migrations <command> [options]

Commands:
  check       Fail on multiple heads, duplicate revision IDs or a dangling
              down_revision. Used in CI.
  heads       List current Alembic heads.
  fix-heads   Generate an empty merge migration for multiple heads.
              --dry-run   show what would run
              -m MSG      merge message (default: merge_N_heads)
  help        Show this message.

Exit codes:
  0  OK
  1  Chain bug ('check': multiple heads, duplicate revision, dangling
     down_revision), or usage error
  2  Alembic unavailable or failed (environment problem, not a chain problem)
EOF
}

case "${1:-help}" in
  check)     shift; cmd_check "$@" ;;
  heads)     shift; cmd_heads "$@" ;;
  fix-heads) shift; cmd_fix_heads "$@" ;;
  help|--help|-h) cmd_help ;;
  *)
    echo -e "${RED}Unknown command: $1${RESET} (see 'bin/migrations help')" >&2
    exit 1 ;;
esac
