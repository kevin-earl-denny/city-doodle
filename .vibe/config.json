{
  "$schema": "./config.schema.json",
  "version": 2,
  "boilerplate": {
    "issues_url": "https://github.com/kdenny/vibe-code-boilerplate/issues"
  },
  "project": {
    "name": "City Doodle",
    "repository": "kevin-earl-denny/city-doodle"
  },
  "tracker": {
    "type": "linear",
    "config": {
      "team_id": "48a87c3c-6f07-4af2-b5aa-4e100919ba26",
      "workspace": "2wrist",
      "team_key": "CITY",
      "github_integration": "native",
      "deployed_state": "Deployed"
    }
  },
  "github": {
    "auth_method": "gh_cli",
    "owner": "kevin-earl-denny",
    "repo": "city-doodle"
  },
  "branching": {
    "pattern": "{PROJ}-{num}",
    "main_branch": "main",
    "always_rebase": true
  },
  "worktrees": {
    "location": "sibling",
    "base_path": "../{repo}-worktrees",
    "auto_cleanup": true
  },
  "labels": {
    "type": [
      "Bug",
      "Feature",
      "Improvement",
      "chore",
      "Refactor"
    ],
    "area": [
      "frontend",
      "backend",
      "Infra",
      "Docs",
      "database",
      "terrain",
      "roads",
      "transit",
      "district"
    ],
    "risk": [
      "Low Risk",
      "Medium Risk"
    ],
    "special": [
      "HUMAN"
    ]
  },
  "security": {
    "secret_scanner": "gitleaks",
    "sbom_generator": "syft",
    "dependency_scanning": true
  },
  "secrets": {
    "providers": [],
    "allowlist_path": ".vibe/secrets.allowlist.json"
  }
}
