# =============================================================================
# City Doodle Web App - Environment Configuration
# =============================================================================
# Copy to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# API endpoint (no trailing slash)
VITE_API_URL=http://localhost:8000

# Environment
VITE_APP_ENV=development

# Clerk publishable key (Clerk Dashboard -> API Keys; pk_test_... for dev).
# Public by design. When unset, the app shows a "sign-in is not configured"
# screen instead of running unauthenticated.
VITE_CLERK_PUBLISHABLE_KEY=
