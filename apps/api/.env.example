# =============================================================================
# City Doodle API - Environment Configuration
# =============================================================================
# Copy to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Application environment (development, staging, production)
APP_ENV=development

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Server port
PORT=8000

# -----------------------------------------------------------------------------
# Database (Neon Postgres)
# -----------------------------------------------------------------------------

# For async operations (FastAPI)
DATABASE_URL=postgresql+asyncpg://user:password@host/city_doodle

# For sync operations (Alembic migrations)
DATABASE_URL_SYNC=postgresql://user:password@host/city_doodle

# -----------------------------------------------------------------------------
# Authentication (Clerk, CITY-644)
# -----------------------------------------------------------------------------

# "production" = require a Clerk session JWT (Authorization: Bearer <jwt>).
# "dev" (default) = trust the X-User-Id header, for local dev/tests ONLY.
AUTH_MODE=dev

# Clerk Frontend API hostname (Clerk Dashboard -> API Keys -> Frontend API URL,
# without https://), e.g. your-app.clerk.accounts.dev. It is the JWT issuer and
# serves the signing keys at https://$CLERK_DOMAIN/.well-known/jwks.json.
CLERK_DOMAIN=

# Clerk secret key (sk_test_/sk_live_). SECRET: set via `fly secrets set`, never
# commit. Used to read a first-time user's primary email + verification status
# from the Clerk Backend API so existing accounts can be linked by verified email.
CLERK_SECRET_KEY=

# Optional: allowed JWT `azp` (origin of the web app) as a JSON array. Defaults to
# CORS_ORIGINS + FRONTEND_URL, plus city-doodle-web Vercel preview URLs.
# CLERK_AUTHORIZED_PARTIES=["https://city-doodle-web.vercel.app"]

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Frontend URL (for production, set to your Vercel URL)
FRONTEND_URL=http://localhost:5173

# Additional allowed origins (JSON array, optional)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# -----------------------------------------------------------------------------
# Worker Communication
# -----------------------------------------------------------------------------

# Redis URL for job queue (if using Redis)
# REDIS_URL=redis://localhost:6379
