# =============================================================================
# City Doodle API - Environment Configuration
# =============================================================================
# Copy to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Application environment (development, staging, production)
APP_ENV=development

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Server port
PORT=8000

# -----------------------------------------------------------------------------
# Database (Neon Postgres)
# -----------------------------------------------------------------------------

# For async operations (FastAPI)
DATABASE_URL=postgresql+asyncpg://user:password@host/city_doodle

# For sync operations (Alembic migrations)
DATABASE_URL_SYNC=postgresql://user:password@host/city_doodle

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------

# Session token expiry in days (default: 7)
SESSION_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Frontend URL (for production, set to your Vercel URL)
FRONTEND_URL=http://localhost:5173

# Additional allowed origins (comma-separated, optional)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Worker Communication
# -----------------------------------------------------------------------------

# Redis URL for job queue (if using Redis)
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# AI terrain prompt (World Brief)
# -----------------------------------------------------------------------------

# Kill switch + key for POST /worlds/brief (503 unless both are set)
# BRIEF_ENABLED=false
# ANTHROPIC_API_KEY=
# BRIEF_MODEL=claude-opus-5-5
# BRIEF_EFFORT=low
# Spend caps (per API process)
# BRIEF_RATE_LIMIT_PER_MINUTE=8
# BRIEF_DAILY_LIMIT_PER_USER=60
# BRIEF_GLOBAL_LIMIT_PER_MINUTE=60
# BRIEF_GLOBAL_DAILY_LIMIT=500   # shared across machines (Postgres)
# BRIEF_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Logging to Axiom (CITY-642)
# -----------------------------------------------------------------------------
# Off unless AXIOM_API_TOKEN is set; with it unset, logs go to stdout exactly as
# before. Shipping is non-blocking and never crashes the app if Axiom is down.
# Routing: only APP_ENV=production writes to AXIOM_DATASET. Any other APP_ENV
# writes to AXIOM_DATASET_DEV, and ships nothing if that is unset, so a dev
# machine can never write into the production dataset.
# On Fly these are secrets: fly secrets set AXIOM_API_TOKEN=... -a <app>

# Ingest token (advanced xaat- token with ingest permission on the dataset). SECRET.
# AXIOM_API_TOKEN=xaat-xxxxx

# Only needed for personal tokens; advanced xaat- tokens work without it.
# AXIOM_ORG_ID=your-org-slug

# Production dataset (default: city-doodle)
# AXIOM_DATASET=city-doodle

# Dev/local dataset. Optional; leave unset to keep non-production logs on stdout.
# AXIOM_DATASET_DEV=city-doodle-dev
