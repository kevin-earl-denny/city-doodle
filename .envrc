# direnv configuration for city-doodle.
#
# Loaded automatically when you cd into the project, if you have direnv
# (https://direnv.net). Run `direnv allow` once in the project root.
# Optional: bin/* load .env.local on their own.
#
# Committed on purpose so every contributor and agent gets the same local
# environment. Secrets belong in .env.local (gitignored), never here.

# 1. Env vars from .env then .env.local (later overrides earlier).
dotenv_if_exists .env
dotenv_if_exists .env.local

# 2. bin/ on PATH so `vibe`, `ticket`, `doctor`, `secrets` work without a prefix.
PATH_add bin

# 3. Per-developer overrides (gitignored). Nothing breaks if absent.
source_env_if_exists .envrc.local
