# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public Configuration (safe to commit if needed)
# -----------------------------------------------------------------------------

# Application environment
APP_ENV=development

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Tracker Configuration
# -----------------------------------------------------------------------------

# Linear workspace (public, not a secret)
# LINEAR_WORKSPACE=your-workspace

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------

# GitHub repository (public)
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo

# -----------------------------------------------------------------------------
# SECRETS (store securely, never commit)
# -----------------------------------------------------------------------------
# The following are examples of what you might need.
# Actual secrets should be stored in:
#   - Local: .env.local (gitignored)
#   - CI: GitHub Actions secrets
#   - Deploy: Platform secret management (Vercel, Fly.io, etc.)

# LINEAR_API_KEY=lin_api_xxxxx

# -- Clerk (authentication, CITY-644) -----------------------------------------
# Get from: Clerk Dashboard -> API Keys. See apps/api/.env.example and
# apps/web/.env.example for where each one is used.
# VITE_CLERK_PUBLISHABLE_KEY=   # web (Vercel env); public, pk_test_/pk_live_
# CLERK_SECRET_KEY=             # API only (Fly secret); sk_test_/sk_live_
# CLERK_DOMAIN=                 # API (Fly secret); Frontend API hostname, e.g. your-app.clerk.accounts.dev
# GITHUB_TOKEN=ghp_xxxxx (if not using gh CLI)
