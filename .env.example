# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public Configuration (safe to commit if needed)
# -----------------------------------------------------------------------------

# Application environment
APP_ENV=development

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Tracker Configuration
# -----------------------------------------------------------------------------

# Linear workspace (public, not a secret)
# LINEAR_WORKSPACE=your-workspace

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------

# GitHub repository (public)
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo

# -----------------------------------------------------------------------------
# SECRETS (store securely, never commit)
# -----------------------------------------------------------------------------
# The following are examples of what you might need.
# Actual secrets should be stored in:
#   - Local: .env.local (gitignored)
#   - CI: GitHub Actions secrets
#   - Deploy: Platform secret management (Vercel, Fly.io, etc.)

# LINEAR_API_KEY=lin_api_xxxxx
# GITHUB_TOKEN=ghp_xxxxx (if not using gh CLI)

# Axiom logs (CITY-642). The API and worker ship logs when AXIOM_API_TOKEN is set
# (see apps/api/.env.example for routing rules). bin/logs reads these from
# .env.local to query logs; the app's ingest token usually can't query, so give
# bin/logs a read-scoped token as AXIOM_QUERY_TOKEN.
# AXIOM_API_TOKEN=xaat-xxxxx          # ingest (apps)
# AXIOM_QUERY_TOKEN=xaat-xxxxx        # query (bin/logs); falls back to AXIOM_API_TOKEN
# AXIOM_ORG_ID=your-org-slug          # only for personal tokens
# AXIOM_DATASET=city-doodle           # production dataset
# AXIOM_DATASET_DEV=city-doodle-dev   # optional; non-production logs ship only if set
